# Docker Environment Configuration
# This file is used by docker-compose for development

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/repoflight

# GitHub Configuration (replace with your actual values)
GITHUB_WEBHOOK_SECRET=dev-webhook-secret-change-in-production
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n# Replace with your actual GitHub App private key\n-----END RSA PRIVATE KEY-----

# Server Configuration
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Dashboard Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Redis Configuration
REDIS_URL=redis://redis:6379

# Logging
LOG_LEVEL=info