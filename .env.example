# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/repoflight"

# Prisma Accelerate (optional - for production performance)
# DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=your-api-key"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/repoflight"

# Supabase Configuration (optional)
SUPABASE_URL="your-supabase-url"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_DATABASE_ACCESS_KEY_ID="your-access-key-id"
SUPABASE_DATABASE_SECRET_ACCESS_KEY="your-secret-access-key"
SUPABASE_DATABASE_ENDPOINT="your-supabase-storage-endpoint"

# GitHub Configuration
GITHUB_WEBHOOK_SECRET="your-webhook-secret-here"
GITHUB_APP_ID="your-github-app-id"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your-github-app-private-key-here
-----END RSA PRIVATE KEY-----"

# Server Configuration
PORT=3001
NODE_ENV=development
BASE_URL="http://localhost:3001"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Dashboard Configuration
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Scan Configuration
SCAN_BRANCHES="main,develop,staging"
SCAN_BRANCH_PATTERNS="feature/.*,hotfix/.*"

# Logging
LOG_LEVEL=info