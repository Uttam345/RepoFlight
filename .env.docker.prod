# Docker Production Environment Configuration
# This file is used by docker-compose.prod.yml

# Database
POSTGRES_PASSWORD=your-secure-postgres-password-here
DATABASE_URL=postgresql://postgres:your-secure-postgres-password-here@postgres:5432/repoflight

# Redis
REDIS_PASSWORD=your-secure-redis-password-here

# GitHub Configuration (REQUIRED - replace with your actual values)
GITHUB_WEBHOOK_SECRET=your-production-webhook-secret
GITHUB_APP_ID=your-github-app-id
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYour actual GitHub App private key here\n-----END RSA PRIVATE KEY-----

# Server Configuration
NODE_ENV=production
BASE_URL=https://your-domain.com

# CORS Configuration
CORS_ORIGIN=https://your-domain.com

# Dashboard Configuration
NEXT_PUBLIC_API_URL=https://your-domain.com

# Logging
LOG_LEVEL=warn